# 前端 (Next.js) — 所有链 / 合约 / RPC 配置由 Worker /config 运行时下发
NEXT_PUBLIC_WORKER_URL=https://hotshort-api.example.workers.dev

# 仅本地 e2e fork 模式：由 scripts/dev-local.sh 自动写入 .env.local，无需手填
# NEXT_PUBLIC_VAULT_ADDRESS=
# BSC_FORK_RPC=https://your-paid-bsc-rpc-here

# Foundry 部署
PRIVATE_KEY=                                # 部署用私钥
BSC_RPC=https://bsc-dataseed.binance.org
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545
BSCSCAN_API_KEY=                            # 可选：forge verify 合约源码

# Worker secrets（cd workers && cp .dev.vars.example .dev.vars）
# SIGNER_PRIVATE_KEY                        — EIP-712 签名钱包，需在 Vault.setSigner 注册
# JWT_SECRET                                — SIWE session token 加密密钥
# BSCSCAN_API_KEY                           — 可选：admin/genesis-scan 才会用
