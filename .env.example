# 前端 (Next.js)
NEXT_PUBLIC_NETWORK=bsc                    # bsc | bsc-testnet | localnet
NEXT_PUBLIC_WORKER_URL=https://hotshort-api.example.workers.dev
NEXT_PUBLIC_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_OWNER_ADDRESSES=               # 逗号分隔，admin-guard 用
PANCAKE_LOTTERY_ADDRESS=                   # Worker 用：薄饼官方 LotteryV2 合约地址

# 本地测试 fork RPC（付费节点，不入 git；写在 .env.local 里）
# BSC_FORK_RPC=https://your-paid-bsc-rpc-here

# Foundry 部署
PRIVATE_KEY=                                # 部署用私钥
BSC_RPC=https://bsc-dataseed.binance.org
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545
BSCSCAN_API_KEY=                           # 可选：用于 forge verify 合约源码

# Worker (cd workers && cp .dev.vars.example .dev.vars)
SIGNER_PRIVATE_KEY=                        # EIP-712 签名钱包，需要在合约 setSigner 注册
JWT_SECRET=                                # SIWE session token 加密密钥
BSCSCAN_API_KEY=                           # 可选：仅 admin/genesis-scan 用（不填则只能 CSV 上传）
