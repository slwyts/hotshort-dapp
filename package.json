{
  "name": "hotshort-dapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "next dev",
    "dev:prod": "cross-env NEXT_PUBLIC_WORKER_URL=https://hs1.afchain.org next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "compile": "forge build",
    "test:contracts": "forge test -vv",
    "node:anvil": "anvil --chain-id 31337",
    "deploy:local": "forge script script/Deploy.s.sol --rpc-url http://127.0.0.1:8545 --broadcast",
    "deploy:bsc-testnet": "forge script script/Deploy.s.sol --rpc-url $BSC_TESTNET_RPC --broadcast --verify --etherscan-api-key $BSCSCAN_API_KEY",
    "deploy:bsc": "forge script script/Deploy.s.sol --rpc-url $BSC_RPC --broadcast --verify --etherscan-api-key $BSCSCAN_API_KEY",
    "deploy:test-tokens:bsc": "forge script script/DeployTestTokens.s.sol --rpc-url $BSC_RPC --broadcast",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "dev:full": "bash scripts/dev-local.sh",
    "worker:deploy": "pnpm --dir workers exec wrangler deploy",
    "worker:db:migrate": "pnpm --dir workers exec wrangler d1 migrations apply hotshort --local",
    "worker:db:migrate:prod": "pnpm --dir workers exec wrangler d1 migrations apply hotshort --remote"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.95.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.562.0",
    "next": "^16.2.1",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sonner": "^1.7.1",
    "sweetalert2": "^11.26.24",
    "tailwind-merge": "^3.4.0",
    "viem": "^2.47.6",
    "wagmi": "^2.19.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.1",
    "headless-web3-provider": "^0.3.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
