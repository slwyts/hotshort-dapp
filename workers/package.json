{
  "name": "hotshort-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "db:migrate": "wrangler d1 migrations apply hotshort --local",
    "db:migrate:prod": "wrangler d1 migrations apply hotshort --remote",
    "db:exec": "wrangler d1 execute hotshort --local",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.12.23",
    "viem": "^2.51.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260530.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.95.0"
  }
}
